#!/usr/bin/env bash
#MISE description="Build odinc, optionally compile an Odin main file (mise run build -- <file> -out:<path>)"
#MISE alias="b"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

binary="$PROJECT_ROOT/build/odinc"
mkdir -p "$PROJECT_ROOT/build"
step "build odinc"
flags=(-vet -strict-style -vet-tabs -disallow-do -warnings-as-errors -o:speed "$COLLECTION")
"$ODIN" build "$PROJECT_ROOT/src/odinc" "${flags[@]}" -out:"$binary" || die "build failed: odinc"
if (($# == 0)); then exit 0; fi
"$binary" "$@"
