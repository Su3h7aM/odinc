#!/usr/bin/env bash
#MISE description="Build an Odin main file into a native executable (mise run build -- <file> -out:<path>)"
#MISE alias="b"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

binary="$PROJECT_ROOT/build/odinc"
mkdir -p "$PROJECT_ROOT/build"
step "build odinc"
"$ODIN" build "$PROJECT_ROOT/src/odinc" -vet -strict-style -vet-tabs -disallow-do -warnings-as-errors "$COLLECTION" -out:"$binary" || die "build failed: odinc"
"$binary" "$@"
