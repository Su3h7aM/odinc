#!/usr/bin/env bash
#MISE description="Type-check and vet every package"
#MISE alias="c"
#USAGE arg "[package]" help="Package to check; omit for all"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

step "check-target"
"$PROJECT_ROOT/scripts/check-target"

flags=(-vet -strict-style -vet-tabs -disallow-do -warnings-as-errors -no-entry-point "$COLLECTION")

target="${usage_package:-${1:-}}"
mapfile -t packages < <(project_packages)
if [[ -n "$target" ]]; then packages=("$target"); fi

failed=()
for package in "${packages[@]}"; do
	step "check $package"
	"$ODIN" check "$PROJECT_ROOT/src/$package" "${flags[@]}" || failed+=("$package")
done
if ((${#failed[@]})); then die "check failed: ${failed[*]}"; fi
