#!/usr/bin/env bash
#MISE description="Print the IR histogram for an Odin file (default examples/demo/demo.odin)"
#USAGE arg "[input]" help="Odin file or directory to histogram; omit for the demo"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

input="${usage_input:-}"
for argument in "$@"; do
	case "$argument" in
		-*) die "unknown flag: $argument" ;;
		*) input="$argument" ;;
	esac
done
if [[ -z "$input" ]]; then input="$PROJECT_ROOT/examples/demo/demo.odin"; fi

mise run build >/dev/null || die "build failed: odinc"
step "histogram $input"
ODIN_ROOT="$PROJECT_ROOT" "$PROJECT_ROOT/build/odinc" "$input" --histogram $COLLECTION
