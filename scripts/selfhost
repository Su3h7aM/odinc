#!/usr/bin/env bash
#MISE description="Build odinc2 and odinc3 with odinc, then build and run the demo with odinc2"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
acquire_binary_lock

binary="$PROJECT_ROOT/build/odinc"
[[ -x "$binary" ]] || die "build/odinc is missing; run mise run build first"

step "selfhost odinc2"
"$binary" "$PROJECT_ROOT/src/odinc" --out="$PROJECT_ROOT/build/odinc2" "$COLLECTION"
step "selfhost odinc3"
"$PROJECT_ROOT/build/odinc2" "$PROJECT_ROOT/src/odinc" --out="$PROJECT_ROOT/build/odinc3" "$COLLECTION"
step "selfhost demo"
"$PROJECT_ROOT/build/odinc2" "$PROJECT_ROOT/examples/demo" --out="$PROJECT_ROOT/build/demo-selfhost"
"$PROJECT_ROOT/build/demo-selfhost" >"$PROJECT_ROOT/build/selfhost-demo.stdout" 2>"$PROJECT_ROOT/build/selfhost-demo.stderr"
