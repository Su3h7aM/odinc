#!/usr/bin/env bash
#MISE description="Build odinc2 and odinc3 with odinc, then build and run the demo with odinc2"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
acquire_binary_lock

binary="$PROJECT_ROOT/build/odinc"
[[ -x "$binary" ]] || die "build/odinc is missing; run mise run build first"

step "selfhost odinc2"
"$binary" build "$PROJECT_ROOT/src/odinc" --output "$PROJECT_ROOT/build/odinc2" --collection "oc=$PROJECT_ROOT/src"
step "selfhost odinc3"
"$PROJECT_ROOT/build/odinc2" build "$PROJECT_ROOT/src/odinc" --output "$PROJECT_ROOT/build/odinc3" --collection "oc=$PROJECT_ROOT/src"
step "selfhost demo"
"$PROJECT_ROOT/build/odinc2" build "$PROJECT_ROOT/examples/demo" --output "$PROJECT_ROOT/build/demo-selfhost"
"$PROJECT_ROOT/build/demo-selfhost" >"$PROJECT_ROOT/build/selfhost-demo.stdout" 2>"$PROJECT_ROOT/build/selfhost-demo.stderr"
