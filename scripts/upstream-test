#!/usr/bin/env bash
#MISE description="Run the fork's upstream test suite against this compiler"
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
FORK_ROOT=/home/su3h7am/Projects/Odin
MODE="${1:-fork}"
ODIN_BIN="$FORK_ROOT/odin"
ODIN_ROOT_DIR="$FORK_ROOT"
if [[ "$MODE" == odinc ]]; then
	ODIN_BIN="$PROJECT_ROOT/build/odinc"
	ODIN_ROOT_DIR="$PROJECT_ROOT"
fi
RUN_ROOT=$(mktemp -d /tmp/nabla-fork-tests.XXXXXX)
trap 'rm -rf "$RUN_ROOT"' EXIT
cp -a "$PROJECT_ROOT/tests" "$RUN_ROOT/tests"
ln -s "$ODIN_BIN" "$RUN_ROOT/odin"
export ODIN="$RUN_ROOT/odin"
export ODIN_ROOT="$ODIN_ROOT_DIR"
LOG="$PROJECT_ROOT/build/upstream-tests-$MODE"
mkdir -p "$LOG"
: > "$LOG/summary.txt"
FLAGS='-vet -vet-tabs -strict-style -vet-style -warnings-as-errors -disallow-do'
TF='-define:ODIN_TEST_FANCY=false -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true'
run_stage() {
 local name="$1"; shift
 printf '\n==> %s\n' "$name"
 ( timeout 3000 bash -c "$*" ) >"$LOG/$name.log" 2>&1
 local code=$?
 printf '%s exit=%s\n' "$name" "$code" | tee -a "$LOG/summary.txt"
 return 0
}
if [[ "${2:-}" == internal ]]; then
	run_stage internal "cd $RUN_ROOT/tests/internal && \"\$ODIN\" test . -all-packages $FLAGS $TF -sanitize:address"
	exit 0
fi
if [[ "${2:-}" == atomic_diagnostics ]]; then
	run_stage atomic_diagnostics "mkdir -p $RUN_ROOT/tests/issues/build && cd $RUN_ROOT/tests/issues/build && \"\$ODIN\" check ../test_issue_atomic_access -no-entry-point -vet-atomic-access -define:ODIN_TEST_FANCY=false -vet -strict-style -ignore-unused-defineables -show-timings"
	exit 0
fi
run_stage examples "\"\$ODIN\" check $FORK_ROOT/examples/all $FLAGS"
run_stage examples_sdl3 "\"\$ODIN\" check $FORK_ROOT/examples/all/sdl3 $FLAGS -no-entry-point"
run_stage internal "cd $RUN_ROOT/tests/internal && \"\$ODIN\" test . -all-packages $FLAGS $TF -sanitize:address"
run_stage core_normal "cd $RUN_ROOT/tests/core && \"\$ODIN\" test normal.odin -file -all-packages $FLAGS $TF -sanitize:address"
run_stage wycheproof "cd $RUN_ROOT/tests/core && \"\$ODIN\" test crypto/wycheproof -vet -vet-tabs -strict-style -vet-style -vet-cast -warnings-as-errors -disallow-do -define:ODIN_TEST_FANCY=false"
run_stage noise "cd $RUN_ROOT/tests/core && \"\$ODIN\" test crypto/noise -vet -vet-tabs -strict-style -vet-style -vet-cast -warnings-as-errors -disallow-do -define:ODIN_TEST_FANCY=false"
run_stage x509_limbo "cd $RUN_ROOT/tests/core && \"\$ODIN\" test crypto/x509_limbo -vet -vet-tabs -strict-style -vet-style -vet-cast -warnings-as-errors -disallow-do -define:ODIN_TEST_FANCY=false"
run_stage vendor "mkdir -p $RUN_ROOT/vendor_build && cp $FORK_ROOT/vendor/lua/5.4/linux/*.so $RUN_ROOT/vendor_build/ && cd $RUN_ROOT/vendor_build && LD_LIBRARY_PATH=$RUN_ROOT/vendor_build \"\$ODIN\" test $RUN_ROOT/tests/vendor -all-packages $FLAGS $TF -sanitize:address"
run_stage issues "cd $RUN_ROOT/tests/issues && ./run.sh"
run_stage abi_default "cd $RUN_ROOT/tests/abi && ABI_CFLAGS= ./run.sh"
run_stage benchmark_check "\"\$ODIN\" check $RUN_ROOT/tests/benchmark -vet -vet-tabs -strict-style -vet-style -warnings-as-errors -disallow-do -no-entry-point"
printf '\nSuite summary: %s\n' "$LOG/summary.txt"
