package main

import "base:intrinsics"

main :: proc() {
	code := 0
	f: f32
	f = 3.5
	if f != 3.5 { code += 1 }
	g: f64
	g = 2.25
	if g != 2.25 { code += 2 }
	a: [2]f32
	a[0] = 3.5
	a[1] = 1.5
	if a[0] != 3.5 || a[1] != 1.5 { code += 4 }
	b: [2]f64
	b[0] = 3.5
	b[1] = 0.5
	if b[0] != 3.5 || b[1] != 0.5 { code += 8 }
	m: matrix[2, 2]f32
	m[0, 0] = 3.5
	m[0, 1] = 1.5
	m[1, 0] = 2.25
	m[1, 1] = 0.5
	if m[0, 0] != 3.5 || m[0, 1] != 1.5 || m[1, 0] != 2.25 || m[1, 1] != 0.5 { code += 16 }
	n: matrix[2, 2]f64
	n[0, 0] = 3.5
	n[0, 1] = 1.5
	n[1, 0] = 2.25
	n[1, 1] = 0.5
	if n[0, 0] != 3.5 || n[0, 1] != 1.5 || n[1, 0] != 2.25 || n[1, 1] != 0.5 { code += 32 }
	mp: [^]f32 = &a[0]
	mp[0] = 2.5
	mp[1] = 0.25
	if a[0] != 2.5 || a[1] != 0.25 || mp[0] != 2.5 || mp[1] != 0.25 { code += 64 }
	a[0] = 3
	b[0] = 4
	m[0, 0] = 5
	n[0, 0] = 6
	mp[1] = 7
	if a[0] != 3 || b[0] != 4 || m[0, 0] != 5 || n[0, 0] != 6 || a[1] != 7 { code += 1 }
	intrinsics.syscall(60, uintptr(42 + code))
}
